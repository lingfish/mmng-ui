#status {
    height: 100%;
    /* border: solid green; */
    /* background: $panel; */
    /* background: $boost; */
    border: greenyellow;
}

#status-container {
    layout: grid;
    grid-size: 1;  /* one columns */
    grid-rows: 80% 20%;
}

