HelpScreen, FilterScreen {
    align: center middle;
}

#help {
    /*grid-size: 2;*/
    /*grid-gutter: 1 2;*/
    /*grid-rows: 1fr 3;*/
    padding: 0 1;
    width: 70%;
    height: 70%;
    /* border: thick $background 80%; */
    border: thick solid yellow;
    /*background: $surface;*/
    overflow-y: auto;
    background: $boost;
}

#filter {
    width: 50%;
    border: thick solid yellow;
}